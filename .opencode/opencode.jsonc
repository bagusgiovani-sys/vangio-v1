{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "instructions": ["docs/fork/**/*.md"],
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  // @sentropic/graphify removed 2026-07-19: latest release (0.17.1, 2026-06-23) predates the
  // current plugin API and fails to load ("Plugin export is not a function") — see errors.md.
  // CodeGraph MCP above covers the codebase-graph need. Re-add if graphify ships a compatible release.
  "plugin": [
    "opencode-mem"
  ],
}
