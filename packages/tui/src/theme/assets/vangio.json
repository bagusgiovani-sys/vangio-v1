{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "vgVoid": "#010D1C",
    "vgPanel": "#08192B",
    "vgFg": "#C7D9EC",
    "vgBlue": "#5B9DFF",
    "vgCyan": "#4FE3E8",
    "vgPurple": "#B98CFF",
    "vgMagenta": "#FF2D6E",
    "vgRed": "#FF5470",
    "vgAmber": "#FFB86B",
    "vgOrange": "#FF9E64",
    "vgGreen": "#63E6A8",
    "vgMuted": "#4A7391",
    "vgGray": "#35566E",
    "vgLight": "#7FA5C4",
    "vgAddedBg": "#062A22",
    "vgRemovedBg": "#2B0F1B"
  },
  "theme": {
    "primary": { "dark": "vgCyan", "light": "vgBlue" },
    "secondary": { "dark": "vgBlue", "light": "vgCyan" },
    "accent": { "dark": "vgPurple", "light": "vgPurple" },
    "error": { "dark": "vgRed", "light": "vgRed" },
    "warning": { "dark": "vgAmber", "light": "vgAmber" },
    "success": { "dark": "vgGreen", "light": "vgGreen" },
    "info": { "dark": "vgBlue", "light": "vgBlue" },
    "text": { "dark": "vgFg", "light": "vgFg" },
    "textMuted": { "dark": "vgMuted", "light": "vgMuted" },
    "background": { "dark": "vgVoid", "light": "vgVoid" },
    "backgroundPanel": { "dark": "vgPanel", "light": "vgPanel" },
    "backgroundElement": { "dark": "vgPanel", "light": "vgPanel" },
    "border": { "dark": "vgGray", "light": "vgGray" },
    "borderActive": { "dark": "vgCyan", "light": "vgCyan" },
    "borderSubtle": { "dark": "vgGray", "light": "vgGray" },
    "diffAdded": { "dark": "vgGreen", "light": "vgGreen" },
    "diffRemoved": { "dark": "vgMagenta", "light": "vgMagenta" },
    "diffContext": { "dark": "vgMuted", "light": "vgMuted" },
    "diffHunkHeader": { "dark": "vgMuted", "light": "vgMuted" },
    "diffHighlightAdded": { "dark": "vgGreen", "light": "vgGreen" },
    "diffHighlightRemoved": { "dark": "vgMagenta", "light": "vgMagenta" },
    "diffAddedBg": { "dark": "vgAddedBg", "light": "vgAddedBg" },
    "diffRemovedBg": { "dark": "vgRemovedBg", "light": "vgRemovedBg" },
    "diffContextBg": { "dark": "vgPanel", "light": "vgPanel" },
    "diffLineNumber": { "dark": "vgGray", "light": "vgGray" },
    "diffAddedLineNumberBg": { "dark": "vgAddedBg", "light": "vgAddedBg" },
    "diffRemovedLineNumberBg": { "dark": "vgRemovedBg", "light": "vgRemovedBg" },
    "markdownText": { "dark": "vgFg", "light": "vgFg" },
    "markdownHeading": { "dark": "vgCyan", "light": "vgCyan" },
    "markdownLink": { "dark": "vgBlue", "light": "vgBlue" },
    "markdownLinkText": { "dark": "vgCyan", "light": "vgCyan" },
    "markdownCode": { "dark": "vgGreen", "light": "vgGreen" },
    "markdownBlockQuote": { "dark": "vgMuted", "light": "vgMuted" },
    "markdownEmph": { "dark": "vgPurple", "light": "vgPurple" },
    "markdownStrong": { "dark": "vgAmber", "light": "vgAmber" },
    "markdownHorizontalRule": { "dark": "vgGray", "light": "vgGray" },
    "markdownListItem": { "dark": "vgCyan", "light": "vgCyan" },
    "markdownListEnumeration": { "dark": "vgBlue", "light": "vgBlue" },
    "markdownImage": { "dark": "vgBlue", "light": "vgBlue" },
    "markdownImageText": { "dark": "vgCyan", "light": "vgCyan" },
    "markdownCodeBlock": { "dark": "vgFg", "light": "vgFg" },
    "syntaxComment": { "dark": "vgGray", "light": "vgGray" },
    "syntaxKeyword": { "dark": "vgPurple", "light": "vgPurple" },
    "syntaxFunction": { "dark": "vgCyan", "light": "vgCyan" },
    "syntaxVariable": { "dark": "vgFg", "light": "vgFg" },
    "syntaxString": { "dark": "vgAmber", "light": "vgAmber" },
    "syntaxNumber": { "dark": "vgOrange", "light": "vgOrange" },
    "syntaxType": { "dark": "vgGreen", "light": "vgGreen" },
    "syntaxOperator": { "dark": "vgBlue", "light": "vgBlue" },
    "syntaxPunctuation": { "dark": "vgLight", "light": "vgLight" }
  }
}
